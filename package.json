{
  "name": "av-courier",
  "productName": "AV Courier",
  "version": "0.1.0",
  "description": "Verified copy queue that finds requested data in the drive/tape catalogue and tells each requester when it is done",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:mac": "bash scripts/build-mac.sh"
  },
  "build": {
    "appId": "com.house.avcourier",
    "productName": "AV Courier",
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "artifactName": "AV-Courier-${version}-Windows-Setup.${ext}"
    },
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "artifactName": "AV-Courier-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "AV Courier ${version}"
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "imapflow": "^2.5.3",
    "mailparser": "^3.9.41",
    "nodemailer": "^10.1.3",
    "qrcode": "^1.5.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
